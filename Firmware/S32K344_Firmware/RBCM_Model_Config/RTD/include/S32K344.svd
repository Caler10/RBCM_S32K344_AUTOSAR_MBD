            </field>
            <field>
              <name>INTMAJOR</name>
              <description>Enable Interrupt If Major count complete</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>INTMAJOR_0</name>
