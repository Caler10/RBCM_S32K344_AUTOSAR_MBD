                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EARQ_1</name>
                  <description>Enable asynchronous DMA request for the channel</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
