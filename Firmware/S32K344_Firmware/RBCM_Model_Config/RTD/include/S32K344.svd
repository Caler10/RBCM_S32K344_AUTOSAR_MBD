                  <description>No eDMA engine stalls</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BWC_1</name>
                  <description>Enable eDMA master high-priority elevation (HPE) mode. No eDMA engine stalls.</description>
