                <enumeratedValue>
                  <name>state</name>
                  <description>State mode. SHIFTBUF contents are used for storing programmable state attributes.</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>logic</name>
