                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>REGISTER</name>
                  <description>RAM read data is registered prior to returning on the system bus, incurring one extra cycle of latency</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
