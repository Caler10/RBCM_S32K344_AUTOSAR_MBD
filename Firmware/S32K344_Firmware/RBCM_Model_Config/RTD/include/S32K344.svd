                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>OPT_NO</name>
                  <description>64-bit WRP4 read bursts are not optimized; the controller returns a 2-2-2-2 response when PRCR1[FT_DIS ]=1</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
