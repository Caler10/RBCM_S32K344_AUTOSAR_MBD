              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DAE_0</name>
                  <description>No destination address configuration error</description>
                  <value>0</value>
                </enumeratedValue>
