                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>id1</name>
                  <description>Enables selection of number of delays in each slave delay tap, based on DLLCRA[SLV_DLY_COARSE].</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
