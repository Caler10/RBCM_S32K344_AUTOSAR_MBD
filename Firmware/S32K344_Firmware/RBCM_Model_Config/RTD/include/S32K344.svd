                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>INTHALF</name>
              <description>Enable Interrupt If Major Counter Half-complete</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
