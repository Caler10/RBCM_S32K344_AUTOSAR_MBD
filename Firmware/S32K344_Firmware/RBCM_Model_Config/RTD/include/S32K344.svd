                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>id1</name>
                  <description>Enables DQS slave delay chain, and should be 1 before any slave configuration settings take place.</description>
                  <value>0x1</value>
                </enumeratedValue>
